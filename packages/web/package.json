{
  "name": "@notnative/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../../scripts/web-css-gate.mjs",
    "preview": "vite preview",
    "start": "node --experimental-transform-types src/server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.ui.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.cross.json",
    "test": "node --max-old-space-size=3072 node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@notnative/ui": "workspace:*",
    "@simplewebauthn/server": "^14.0.2",
    "cron-parser": "^5.10.1",
    "hono": "^4.8.3",
    "node-pty": "^1.1.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "ws": "^8.21.3",
    "yaml": "^2.9.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "bin": {
    "notnative": "src/cli/bin.ts"
  }
}
